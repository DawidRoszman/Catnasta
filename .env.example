# Copy to .env and fill in before running docker-compose.prod.yml.

# MongoDB root credentials (only reachable inside the Docker network).
MONGO_USER=catnasta
MONGO_PASSWORD=change-me-to-a-long-random-string

# Signs login tokens. Generate one with: openssl rand -hex 32
TOKEN_SECRET=change-me

# Only needed with `--profile tunnel`. Create a tunnel in Cloudflare Zero Trust
# and copy its token; route the public hostname to http://frontend:3000.
CLOUDFLARE_TUNNEL_TOKEN=
